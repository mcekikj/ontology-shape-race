# Copy to .env and fill in after the Azure environment is deployed.
# Never commit .env.

# Microsoft Foundry endpoint, e.g. https://<account>.cognitiveservices.azure.com
ONTOLOGY_AGENTS_ENDPOINT=

# Optional: API key. Leave empty to use Entra ID via az login.
AZURE_OPENAI_API_KEY=

# Required: the agent's four tools query these graphs. Get the key with:
#   az cosmosdb keys list -g rg-ontology-agents -n <cosmos-account> \
#     --query primaryMasterKey -o tsv
COSMOS_GREMLIN_ENDPOINT=
COSMOS_GREMLIN_KEY=
